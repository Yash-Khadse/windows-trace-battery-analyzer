# Copy to .env (gitignored) and fill in. Never commit .env.
# Isolated Docker Postgres for WTBA (port 5433, localhost only).
WTBA_DB_HOST=127.0.0.1
WTBA_DB_PORT=5433
WTBA_DB_NAME=wtba
# Bootstrap superuser (init only; never used by the pipeline or API)
WTBA_DB_ADMIN_USER=wtba_admin
WTBA_DB_ADMIN_PASSWORD=change-me-admin
# Read-write app role (owns the database, runs migrations)
WTBA_DB_USER=wtba_rw
WTBA_DB_PASSWORD=change-me
# Read-only role used by the API
WTBA_DB_RO_USER=wtba_ro
WTBA_DB_RO_PASSWORD=change-me-too
# Salt for hashing machine id at ingest: random, >= 16 chars, never a placeholder
# (generate e.g. with: python -c "import secrets;print(secrets.token_hex(32))")
WTBA_HASH_SALT=change-me-random
